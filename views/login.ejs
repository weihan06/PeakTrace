<%- include('partials/head') %>
<div class="row justify-content-center">
  <div class="col-md-5 col-lg-4">
    <div class="card p-4">
      <h1 class="h4 mb-3 text-center"><i class="bi bi-triangle-fill text-success"></i> 登入 PeakTrace</h1>
      <form method="post" action="/login">
        <div class="mb-3"><label class="form-label">帳號</label>
          <input class="form-control" name="username" value="<%= username %>" maxlength="30" required autofocus>
          <div class="form-text">輸入帳號即可登入，新帳號會自動建立。</div></div>
        <button class="btn btn-success w-100">登入</button>
      </form>
    </div>
  </div>
</div>
<%- include('partials/foot') %>
