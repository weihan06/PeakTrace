<%- include('partials/head') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">約爬山</h1>
  <a href="/plans/new" class="btn btn-success"><i class="bi bi-calendar-plus"></i> 發起行程</a>
</div>

<% const card = (pl) => { %>
  <div class="col-md-6 col-xl-4">
    <a href="/plans/<%= pl.id %>" class="card p-3 h-100 text-decoration-none text-body">
      <div class="d-flex justify-content-between">
        <div class="fw-semibold"><%= pl.title %></div>
        <% if (myIds.has(pl.id)) { %><span class="badge text-bg-success">已報名</span><% } %>
      </div>
      <div class="small text-body-secondary mb-2"><i class="bi bi-calendar-event"></i> <%= pl.start_date %><%= pl.end_date !== pl.start_date ? ' ~ ' + pl.end_date : '' %>
        · 發起人 <%= pl.creator_name %> · <%= pl.member_count %> 人</div>
      <div><% pl.peaks.forEach((p) => { %><span class="badge text-bg-light border me-1 mb-1">#<%= p.no %> <%= p.name %> <%= p.elevation %>m</span><% }) %></div>
    </a>
  </div>
<% } %>

<h2 class="h5">即將出發</h2>
<div class="row g-3 mb-4">
  <% if (!upcoming.length) { %><div class="col text-body-secondary">目前沒有行程，發起一個吧！</div><% } %>
  <% upcoming.forEach(card) %>
</div>

<% if (past.length) { %>
<h2 class="h5">過去的行程</h2>
<div class="row g-3 opacity-75"><% past.forEach(card) %></div>
<% } %>
<%- include('partials/foot') %>
