<%- include('partials/head') %>
<div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
  <h1 class="h3 mb-0"><%= isSelf ? '我的百岳儀表板' : `${profile.display_name} 的百岳` %></h1>
  <% if (isSelf) { %>
  <div class="d-flex gap-2">
    <a href="/climbs" class="btn btn-success"><i class="bi bi-plus-lg"></i> 新增完登</a>
    <a href="/plans/new" class="btn btn-outline-success"><i class="bi bi-calendar-plus"></i> 約爬山</a>
  </div>
  <% } %>
</div>

<div class="row g-3 mb-3">
  <div class="col-lg-4">
    <div class="card h-100 p-4">
      <div class="progress-ring" style="--p: <%= stats.percent %>">
        <div><div><div class="stat-big"><%= stats.done %></div><div class="stat-label">/ <%= stats.total %> 座</div></div></div>
      </div>
      <div class="text-center mt-3">
        <div class="fs-5 fw-semibold">完成 <%= stats.percent %>%</div>
        <div class="text-body-secondary small">還差 <%= stats.remaining %> 座就完登百岳<%= stats.remaining === 0 ? '——恭喜完登！🎉' : '' %></div>
      </div>
    </div>
  </div>
  <div class="col-lg-8">
    <div class="row g-3 h-100">
      <div class="col-6 col-md-3"><div class="card p-3 h-100"><div class="stat-label">已完登</div><div class="fs-2 fw-bold"><%= stats.done %></div></div></div>
      <div class="col-6 col-md-3"><div class="card p-3 h-100"><div class="stat-label">登頂次數</div><div class="fs-2 fw-bold"><%= stats.totalClimbs %></div></div></div>
      <div class="col-6 col-md-3"><div class="card p-3 h-100"><div class="stat-label">最高登頂</div>
        <div class="fs-5 fw-bold"><%= stats.highest ? stats.highest.name : '—' %></div>
        <div class="small text-body-secondary"><%= stats.highest ? stats.highest.elevation + ' m' : '' %></div></div></div>
      <div class="col-6 col-md-3"><div class="card p-3 h-100"><div class="stat-label">累積高度</div>
        <div class="fs-5 fw-bold"><%= stats.totalElevation.toLocaleString() %> m</div></div></div>
      <div class="col-12">
        <div class="card p-3 h-100">
          <div class="fw-semibold mb-2">分區完成度</div>
          <% stats.byRegion.forEach((r) => { const pct = Math.round(r.done / r.total * 100); %>
          <div class="d-flex align-items-center mb-2">
            <div style="width:3.5rem" class="small"><%= r.region %></div>
            <div class="progress flex-grow-1" style="height: 1.1rem">
              <div class="progress-bar bg-success" style="width: <%= pct %>%"><%= pct >= 12 ? pct + '%' : '' %></div>
            </div>
            <div class="small ms-2 text-end" style="width:4rem"><%= r.done %> / <%= r.total %></div>
          </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-8">
    <div class="card p-3">
      <div class="fw-semibold mb-2">完登地圖</div>
      <div id="map" class="peak-map"></div>
    </div>
  </div>
  <div class="col-lg-4">
    <div class="card p-3 mb-3">
      <div class="fw-semibold mb-2">最近完登</div>
      <% if (!recent.length) { %><div class="text-body-secondary small">尚無紀錄<%= isSelf ? '，到「登山紀錄」新增第一座百岳吧！' : '' %></div><% } %>
      <ul class="list-group list-group-flush">
        <% recent.forEach((c) => { %>
        <li class="list-group-item px-0 d-flex justify-content-between">
          <a href="/peaks/<%= c.peak_no %>" class="text-decoration-none">#<%= c.peak_no %> <%= c.name %></a>
          <span class="text-body-secondary small"><%= c.climb_date %></span>
        </li>
        <% }) %>
      </ul>
    </div>
    <div class="card p-3 mb-3">
      <div class="fw-semibold mb-2">即將出發的行程</div>
      <% if (!plans.length) { %><div class="text-body-secondary small">目前沒有報名的行程</div><% } %>
      <% plans.forEach((pl) => { %>
        <a href="/plans/<%= pl.id %>" class="d-block text-decoration-none mb-2">
          <div class="fw-semibold"><%= pl.title %></div>
          <div class="small text-body-secondary"><i class="bi bi-calendar-event"></i> <%= pl.start_date %><%= pl.end_date !== pl.start_date ? ' ~ ' + pl.end_date : '' %> · <%= pl.member_count %> 人</div>
        </a>
      <% }) %>
    </div>
    <% if (stats.byYear.length) { %>
    <div class="card p-3">
      <div class="fw-semibold mb-2">每年新完登</div>
      <% const maxN = Math.max(...stats.byYear.map((y) => y.n)); stats.byYear.forEach((y) => { %>
      <div class="d-flex align-items-center mb-1 small">
        <div style="width:3rem"><%= y.year %></div>
        <div class="progress flex-grow-1" style="height:.8rem"><div class="progress-bar bg-success" style="width: <%= y.n / maxN * 100 %>%"></div></div>
        <div style="width:2.5rem" class="text-end"><%= y.n %></div>
      </div>
      <% }) %>
    </div>
    <% } %>
  </div>
</div>

<script>
  const peaks = <%- JSON.stringify(stats.peaks).replace(/</g, '\\u003c') %>;
  const map = PeakMap.create(document.getElementById('map'));
  peaks.filter((p) => p.lat != null).forEach((p) => {
    PeakMap.marker(p, p.done ? PeakMap.COLORS.done : PeakMap.COLORS.todo, p.done ? 8 : 6)
      .bindPopup(PeakMap.popupHtml(p)).addTo(map);
  });
  PeakMap.legend(map, [['已完登', PeakMap.COLORS.done], ['未完登', PeakMap.COLORS.todo]]);
</script>
<%- include('partials/foot') %>
