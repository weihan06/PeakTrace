<%- include('partials/head') %>
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
  <h1 class="h3 mb-0">#<%= peak.no %> <%= peak.name %> <small class="text-body-secondary fs-5"><%= peak.elevation %> m</small>
    <% if (mine.length) { %><span class="badge text-bg-success fs-6 align-middle">已完登</span><% } %></h1>
  <div class="d-flex gap-2">
    <a href="/climbs?peak=<%= peak.no %>" class="btn btn-success"><i class="bi bi-check2-circle"></i> 登記完登</a>
    <a href="/plans/new?peak=<%= peak.no %>" class="btn btn-outline-success"><i class="bi bi-calendar-plus"></i> 約爬這座</a>
  </div>
</div>

<div class="row g-3 mb-3">
  <div class="col-lg-5">
    <div class="card p-3 h-100">
      <table class="table table-sm mb-0">
        <tr><th style="width:7rem">編號</th><td><%= peak.no %></td></tr>
        <tr><th>高度</th><td><%= peak.elevation %> m</td></tr>
        <tr><th>縣市</th><td><%= peak.counties %></td></tr>
        <tr><th>區域</th><td><%= peak.region %></td></tr>
        <tr><th>山脈</th><td><%= peak.range_name %></td></tr>
        <tr><th>登山路線</th><td><%= peak.route %></td></tr>
        <tr><th>國家公園</th><td><%= peak.national_park || '—' %></td></tr>
        <tr><th>難度分級</th><td><%= peak.grade ?? '—' %> <small class="text-body-secondary">（0–6 級）</small></td></tr>
        <tr><th>座標</th><td><% if (peak.lat != null) { %><%= peak.lat %>, <%= peak.lng %><br>
          <a href="<%= peak.google_maps_url %>" target="_blank" rel="noopener"><i class="bi bi-geo-alt"></i> Google 地圖</a><% } %></td></tr>
        <tr><th>參考資料</th><td><a href="<%= peak.wiki_url %>" target="_blank" rel="noopener">維基百科</a></td></tr>
      </table>
    </div>
  </div>
  <div class="col-lg-7"><div class="card p-3 h-100"><div id="map" class="peak-map small h-100" style="min-height:320px"></div></div></div>
</div>

<div class="card p-3 mb-3">
  <div class="fw-semibold mb-2"><i class="bi bi-cloud-sun"></i> 山頂 16 天天氣預報 <small class="text-body-secondary">（依 <%= peak.elevation %> m 高度修正）</small></div>
  <% if (weather) { %><%- include('partials/weather-days', { days: weather }) %>
  <% } else { %><div class="text-body-secondary small">目前無法取得天氣資料<%= weatherError ? '：' + weatherError : '' %></div><% } %>
</div>

<div class="row g-3">
  <div class="col-md-6">
    <div class="card p-3 h-100">
      <div class="fw-semibold mb-2">即將出發的相關行程</div>
      <% if (!plans.length) { %><div class="text-body-secondary small">尚無行程，<a href="/plans/new?peak=<%= peak.no %>">發起一個</a>？</div><% } %>
      <% plans.forEach((pl) => { %>
        <a href="/plans/<%= pl.id %>" class="d-block mb-2"><%= pl.start_date %> · <%= pl.title %>（<%= pl.member_count %> 人）</a>
      <% }) %>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card p-3 h-100">
      <div class="fw-semibold mb-2">山友完登紀錄</div>
      <% if (!climbs.length) { %><div class="text-body-secondary small">尚無人完登</div><% } %>
      <ul class="list-group list-group-flush">
      <% climbs.forEach((c) => { %>
        <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
          <span><a href="/users/<%= c.user_id %>"><%= c.display_name %></a> <small class="text-body-secondary"><%= c.note ?? '' %></small></span>
          <span class="small text-body-secondary"><%= c.climb_date %></span>
        </li>
      <% }) %>
      </ul>
    </div>
  </div>
</div>
<script>
  const peak = <%- JSON.stringify(peak).replace(/</g, '\\u003c') %>;
  if (peak.lat != null) {
    const map = PeakMap.create(document.getElementById('map'));
    map.setView([peak.lat, peak.lng], 12);
    PeakMap.marker(peak, PeakMap.COLORS.selected, 10).addTo(map);
  }
</script>
<%- include('partials/foot') %>
